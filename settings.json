
/* =================================
   DEVANGOLA - DESIGN PRINCIPAL
================================= */

:root {
    --blue: #1769e0;
    --dark-blue: #1052b5;
    --light-blue: #eaf2ff;
    --white: #ffffff;
    --background: #f7f9fc;
    --text: #17243a;
    --muted: #68768b;
    --border: #e5eaf2;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    display: block;
}

/* =================================
   HEADER
================================= */

.header {
    min-height: 76px;
    padding: 14px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    background: white;
    border-bottom: 1px solid var(--border);
}

.logo {
    font-size: 23px;
    font-weight: 800;
    color: var(--text);
    white-space: nowrap;
}

.logo span {
    color: var(--blue);
}

.header nav {
    display: flex;
    align-items: center;
    gap: 30px;
}

.header nav a {
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    transition: .3s;
}

.header nav a:hover,
.header nav a.active {
    color: var(--blue);
}

.header-button {
    background: var(--blue);
    color: white;
    padding: 11px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    transition: .3s;
}

.header-button:hover {
    background: var(--dark-blue);
}

/* =================================
   BOTÕES
================================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: .3s;
    text-align: center;
}

.btn-blue {
    background: var(--blue);
    color: white;
}

.btn-blue:hover {
    background: var(--dark-blue);
    transform: translateY(-3px);
}

.btn-outline {
    border: 1px solid var(--blue);
    color: var(--blue);
    background: white;
}

.btn-outline:hover {
    background: var(--light-blue);
}

.btn-white {
    background: white;
    color: var(--blue);
}

.btn-white:hover {
    background: var(--light-blue);
    transform: translateY(-3px);
}

.full-button {
    width: 100%;
}

/* =================================
   HERO
================================= */

.hero {
    padding: 85px 8%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 55px;
    background: linear-gradient(120deg, #ffffff, #edf4ff);
}

.tag {
    display: inline-block;
    padding: 7px 14px;
    border-radius: 30px;
    background: var(--light-blue);
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}

.hero h1,
.inner-hero h1 {
    font-size: clamp(37px, 5vw, 60px);
    line-height: 1.12;
    letter-spacing: -2px;
    margin: 23px 0;
}

.hero h1 span,
.inner-hero h1 span {
    color: var(--blue);
}

.hero-content > p,
.inner-hero p {
    font-size: 16px;
    color: var(--muted);
    max-width: 550px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
}

.hero-bottom {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--muted);
}

.online-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #20b875;
}

.hero-image {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    min-height: 370px;
}

.hero-image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
}

.image-label {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 30px 23px;
    color: white;
    background: linear-gradient(transparent, rgba(0,0,0,.85));
    display: flex;
    flex-direction: column;
}

.image-label strong {
    font-size: 21px;
}

.image-label span {
    font-size: 13px;
    color: #e1eaff;
}

/* =================================
   SECÇÕES
================================= */

.section {
    padding: 80px 8%;
}

.section-heading {
    text-align: center;
    margin-bottom: 38px;
}

.section-heading h2 {
    font-size: 32px;
    margin: 15px 0 8px;
    letter-spacing: -1px;
}

.section-heading p {
    color: var(--muted);
    font-size: 15px;
}

/* =================================
   CARTÕES DE FUNCIONALIDADES
================================= */

.feature-grid {
    max-width: 1150px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.feature-card {
    padding: 25px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: .3s;
}

.feature-card:hover {
    transform: translateY(-5px);
    border-color: var(--blue);
    box-shadow: 0 12px 30px rgba(23, 105, 224, .08);
}

.feature-icon {
    width: 49px;
    height: 49px;
    display: grid;
    place-items: center;
    background: var(--light-blue);
    border-radius: 12px;
    font-size: 23px;
    margin-bottom: 17px;
}

.feature-card h3 {
    font-size: 18px;
    margin-bottom: 8px;
}

.feature-card p {
    font-size: 13px;
    color: var(--muted);
}

/* =================================
   GALERIA DE IMAGENS
================================= */

.gallery-section {
    background: #f0f5fc;
}

.gallery-grid {
    max-width: 1150px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.photo-card {
    position: relative;
    border-radius: 15px;
    overflow: hidden;
    min-height: 300px;
    background: #dbe6f4;
}

.photo-card img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    transition: transform .6s;
}

.photo-card:hover img {
    transform: scale(1.07);
}

.photo-caption {
    position: absolute;
    bottom: 0;
    width: 100%;
    padding: 30px 20px 20px;
    color: white;
    background: linear-gradient(transparent, rgba(0,0,0,.88));
}

.photo-caption span {
    font-size: 11px;
    font-weight: 800;
    color: #9fc4ff;
    letter-spacing: 1px;
}

.photo-caption h3 {
    font-size: 19px;
    margin-top: 7px;
}

/* =================================
   CONVITE
================================= */

.invite-section {
    text-align: center;
    padding: 75px 8%;
    background: var(--blue);
    color: white;
}

.invite-section > span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}

.invite-section h2 {
    font-size: 36px;
    margin: 12px 0;
}

.invite-section p {
    max-width: 600px;
    margin: 0 auto 25px;
    color: #e5efff;
}

/* =================================
   PÁGINAS INTERNAS
================================= */

.inner-hero {
    padding: 80px 8%;
    text-align: center;
    background: linear-gradient(120deg, white, #edf4ff);
}

.inner-hero h1 {
    max-width: 850px;
    margin: 20px auto;
}

.inner-hero p {
    margin: auto;
}

/* SOBRE */

.about-layout {
    padding: 75px 8%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 50px;
    background: white;
}

.about-image {
    overflow: hidden;
    border-radius: 16px;
}

.about-image img {
    width: 100%;
    height: 380px;
    object-fit: cover;
}

.about-text h2 {
    font-size: 32px;
    line-height: 1.25;
    margin: 18px 0;
}

.about-text p {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 15px;
}

.about-text .btn {
    margin-top: 12px;
}

/* IMAGEM LARGA */

.wide-image-section {
    position: relative;
    height: 400px;
    overflow: hidden;
}

.wide-image-section > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.wide-image-overlay {
    position: absolute;
    inset: 0;
    padding: 40px 8%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    background: linear-gradient(90deg, rgba(8,24,50,.85), rgba(8,24,50,.2));
    color: white;
}

.wide-image-overlay h2 {
    max-width: 600px;
    font-size: 36px;
    margin: 18px 0 25px;
}

/* =================================
   COMUNIDADE
================================= */

.community-layout {
    padding: 70px 8%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 45px;
    background: white;
}

.community-photo {
    overflow: hidden;
    border-radius: 16px;
}

.community-photo img {
    width: 100%;
    height: 470px;
    object-fit: cover;
}

.community-content h2 {
    font-size: 30px;
    line-height: 1.3;
    margin: 18px 0;
}

.community-content > p {
    color: var(--muted);
    font-size: 14px;
}

.benefit-list {
    margin: 22px 0;
    padding: 20px;
    background: var(--light-blue);
    border-radius: 12px;
}

.benefit-list div {
    font-size: 14px;
    padding: 5px 0;
}

.goal-box {
    margin-bottom: 22px;
    display: flex;
    flex-direction: column;
}

.goal-box > span {
    color: var(--blue);
    font-size: 11px;
    font-weight: 800;
}

.goal-box strong {
    color: var(--blue);
    font-size: 37px;
}

.goal-box p {
    color: var(--muted);
    font-size: 13px;
}

/* =================================
   RODAPÉ HORIZONTAL ANIMADO
================================= */

.footer {
    background: #101c31;
    color: white;
    overflow: hidden;
}

.marquee {
    overflow: hidden;
    width: 100%;
    background: var(--blue);
    padding: 20px 0;
    white-space: nowrap;
}

.marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-move 30s linear infinite;
}

.marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 35px;
    padding-right: 35px;
}

.marquee-group span {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 2px;
    flex-shrink: 0;
}

.marquee-group span:nth-child(even) {
    color: #bcd5ff;
    font-size: 21px;
}

@keyframes marquee-move {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }
}

.footer-main {
    padding: 45px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.footer-logo {
    font-size: 24px;
    font-weight: 800;
    color: white;
}

.footer-main p {
    color: #aab9d0;
    font-size: 13px;
    margin-top: 8px;
}

.footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
}

.footer-links a {
    font-size: 13px;
    color: #d5deec;
    transition: .3s;
}

.footer-links a:hover {
    color: #69a3ff;
}

.footer-bottom {
    padding: 20px 8%;
    border-top: 1px solid #29364c;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #aab9d0;
    font-size: 12px;
}

/* =================================
   RESPONSIVIDADE
================================= */

@media (max-width: 950px) {

    .feature-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        gap: 30px;
        padding: 65px 6%;
    }

    .about-layout,
    .community-layout {
        gap: 30px;
    }
}

@media (max-width: 700px) {

    .header {
        padding: 15px 5%;
        flex-direction: column;
        gap: 13px;
    }

    .header nav {
        gap: 23px;
    }

    .header nav a {
        font-size: 13px;
    }

    .header-button {
        display: none;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 60px 6%;
    }

    .hero h1,
    .inner-hero h1 {
        font-size: 42px;
    }

    .hero-image img {
        height: 300px;
    }

    .section {
        padding: 60px 5%;
    }

    .gallery-grid {
        grid-template-columns: 1fr;
    }

    .photo-card img {
        height: 270px;
    }

    .about-layout,
    .community-layout {
        grid-template-columns: 1fr;
        padding: 50px 6%;
    }

    .about-image img,
    .community-photo img {
        height: 300px;
    }

    .wide-image-overlay h2 {
        font-size: 27px;
    }

    .footer-main {
        flex-direction: column;
        align-items: flex-start;
        padding: 35px 6%;
    }

    .footer-bottom {
        padding: 20px 6%;
        flex-direction: column;
    }

    .invite-section h2 {
        font-size: 29px;
    }
}

@media (max-width: 420px) {

    .header nav {
        gap: 15px;
    }

    .header nav a {
        font-size: 12px;
    }

    .hero h1,
    .inner-hero h1 {
        font-size: 35px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .hero-actions {
        flex-direction: column;
    }

    .hero-actions .btn {
        width: 100%;
    }

    .footer-links {
        gap: 16px;
    }
}

/* ACESSIBILIDADE */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
